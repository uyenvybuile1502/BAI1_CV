import cv2
import numpy as np

img_path = "/Users/buileuyenvy/Downloads/Fig0237(a)(characters test pattern)_POST.png"  
img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)

if img is None:
    img = np.random.randint(0, 256, (256, 256), dtype=np.uint8)

k = 3
a = k // 2

img_pad = np.pad(img, a, mode='constant', constant_values=0)

H, W = img.shape
img_out = np.zeros((H, W), dtype=np.uint8)

for y in range(H):
    for x in range(W):
        total = 0
        for s in range(-a, a + 1):
            for t in range(-a, a + 1):
                total += int(img_pad[y + a + s, x + a + t])
        img_out[y, x] = total // (k * k)

cv2.imshow('Original image', img)
cv2.imshow('Averaging Filter (Mean)', img_out)

cv2.waitKey(0)
cv2.destroyAllWindows()
