import cv2
import numpy as np


img_path = "/Users/buileuyenvy/Desktop/hoa_qua.png" 
img = cv2.imread(img_path)

if img is None:
    img = np.random.randint(0, 256, (300, 300, 3), dtype=np.uint8)

img_float = img.astype(np.float32) / 255.0
b, g, r = cv2.split(img_float)

I = (r + g + b) / 3.0

min_rgb = np.minimum(np.minimum(r, g), b)
S = 1.0 - (3.0 / (r + g + b + 1e-6)) * min_rgb 

num = 0.5 * ((r - g) + (r - b))
den = np.sqrt((r - g)**2 + (r - b)*(g - b)) + 1e-6
theta = np.arccos(np.clip(num / den, -1.0, 1.0))

H = theta
H[b > g] = 2 * np.pi - H[b > g]
H = H / (2 * np.pi) 

cv2.imshow('Original Image', img)
cv2.imshow('Hue (H)', (H * 255).astype(np.uint8))
cv2.imshow('Saturation (S)', (S * 255).astype(np.uint8))
cv2.imshow('Intensity (I)', (I * 255).astype(np.uint8))

cv2.waitKey(0)
cv2.destroyAllWindows()
