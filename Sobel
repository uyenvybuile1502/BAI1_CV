import cv2
import numpy as np

img_path = "/Users/buileuyenvy/Downloads/Fig0343(a)(skeleton_orig).png"  
img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)

if img is None:
    img = np.random.randint(0, 256, (300, 300), dtype=np.uint8)

sobel_x = cv2.Sobel(img, cv2.CV_64F, 1, 0, ksize=3)
sobel_y = cv2.Sobel(img, cv2.CV_64F, 0, 1, ksize=3)

sobel_out = np.uint8(np.abs(sobel_x) + np.abs(sobel_y))

cv2.imshow('Original Image', img)
cv2.imshow('Sobel Edge Detection', sobel_out)

cv2.waitKey(0)
cv2.destroyAllWindows()
